        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150" />
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150" />
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup</previewCommands>
  <experiments />
</model>
