<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[breed [domacinstva docinstvo]
undirected-link-breed [poznanstva poznanstvo]

globals [
  centar
  potrebe-sedmica posudbe-sedmica odbijanja-sedmica ogranicenja-sedmica
  potrebe-ukupno posudbe-ukupno odbijanja-ukupno ogranicenja-ukupno
]
patches-own [raspolozivo]
domacinstva-own [stav integritet budzet posudba iskustvo posudio-ikada? potreba? zahtjev?]

to setup
  clear-all
  random-seed sjeme
  if pocetni-stav-min > pocetni-stav-max[
    error "Početni minimum stava treba biti manji ili jednak masimumu."
  ]
  postavi-svijet
  postavi-centar
  postavi-domacinstva
  postavi-poznanstva
  
  postavi-brojace
  reset-ticks
end

to postavi-svijet
  resize-world -10 10 -10 10
  set-topology false false
  ask patches [set pcolor 9]
end

to postavi-centar
  set centar patch 0 0
  ask centar [
    set pcolor orange
    set raspolozivo zaliha ;; inicijalno su svi komadi alata raspolozivi
  ]
end

to postavi-domacinstva
  ask n-of 100 patches with [self != centar] [
    sprout-domacinstva 1[
      set color sky
      set shape "house"
      set size 0.8
      ;; iniciajlizacija atributa domacinstava
      set stav pocetni-stav-min + random-float (pocetni-stav-max - pocetni-stav-min)
      set integritet random-float 1
      set budzet random-float 8
      set posudba 0
      set iskustvo "nema"
      set posudio-ikada? false
    ]
  ]
end

to postavi-poznanstva
  ;; jedna veza/poszanstvo po paru
  ask domacinstva [
    let kandidati (other domacinstva in-radius 4) with [who > [who] of myself]
    ask kandidati [
      if random-float 1 < 0.3 [
        create-poznanstvo-with myself [
          set color gray
          set thickness 0.08
      ]
      ]
    ]
  ]
end

to go
  stop
end

to pripremi-sedmicu
  set potrebe-sedmica 0
  set posudbe-sedmica 0
  set odbijanja-sedmica 0
  set ogranicenja-sedmica 0
  ask domacinstva [
    set potreba? false
    set zahtjev? false
  ]
end

to razgovor
  ;; Dopuniti na odgovarajucem koraku.
end

to povrat-i-uplata
  ;; Dopuniti na odgovarajucem koraku.
end

to formiraj-zahtjeve
  ;; Dopuniti na odgovarajucem koraku.
end

to dodijeli-alat
  ;; Dopuniti na odgovarajucem koraku.
end

to azuriraj-mjere
  ;; Dopuniti na odgovarajucem koraku.
end

to postavi-brojace
  set potrebe-ukupno 0
  set posudbe-ukupno 0
  set odbijanja-ukupno 0
  set ogranicenja-ukupno 0
  pripremi-sedmicu
end

to-report doseg
  report "nedefinisano"
end

to-report zadovoljene-potrebe
  report "nedefinisano"
end
]]></code>
  <widgets>
    <view x="360" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-10" height="445" showTickCounter="true" patchSize="21.0" fontSize="10" wrappingAllowedY="false" width="445" tickCounterLabel="sedmica" maxPycor="10" updateMode="0" maxPxcor="10" minPxcor="-10" />
    <slider x="15" step="0.01" y="100" max="1" width="250" display="p-potrebe" height="50" min="0" direction="Horizontal" default="0.2" variable="p-potrebe" />
    <slider x="15" step="5" y="280" max="20" width="250" display="zaliha" height="50" min="5" direction="Horizontal" default="10.0" variable="zaliha" />
    <slider x="15" step="1" y="160" max="4" width="250" display="naknada" height="50" min="0" direction="Horizontal" default="2.0" variable="naknada" units="KM" />
